# ─── Local development (.env.local) ──────────────────────────────────────────
# `pnpm backend:up` writes these for the docker backend; a cloud deployment
# uses CONVEX_DEPLOYMENT instead.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3220
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ─── Deployment env vars (`pnpm exec convex env set KEY VALUE`) ─────────────
# mock | real (ADR 0002). Real adapters throw when their key is missing.
PROVIDERS_MODE=mock
# The product the accounts promote, its website and the studio's own address
# are not env vars: the studio's first-run setup stores them in the workspace,
# and the Providers page changes them.

# Real providers
ANTHROPIC_API_KEY=
# Conversions: your product's PostHog project (docs/plan.md, "What the product must emit").
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
# Reddit: a "web app" at https://www.reddit.com/prefs/apps whose redirect URI is
# <CONVEX_SITE_URL>/oauth/reddit/callback (locally http://127.0.0.1:3221/oauth/reddit/callback).
# The user agent names the app and its owner, e.g. "web:influstep:0.1 (by /u/yourname)".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Web push (docs/plan.md, "Notifier: web push"): a VAPID key pair and a contact
# address for the push services. `pnpm backend:up` sets a local pair; make one
# for a cloud deployment with `pnpm --filter @influstep/convex exec web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
